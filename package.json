{
  "name": "vite-project",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "prepare": "husky",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:run": "vitest --run",
    "lint": "eslint --cache --fix src/*/**.{tsx,ts}",
    "lint:knip": "knip",
    "lint:spelling": "cspell \"**\"",
    "format": "prettier --write src/*.{tsx,ts}",
    "isready": "pnpm run lint && pnpm run lint:knip && pnpm run lint:spelling && pnpm run format && pnpm run build && pnpm run test:run",
    "generate-icons": "npx @svgr/cli --config-file=.svgrrc.json ./src/assets/icons --out-dir=./src/icons && pnpm run lint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release": "release-it"
  },
  "dependencies": {
    "@eslint/js": "^9.39.2",
    "@reduxjs/toolkit": "2.9.0",
    "@tanstack/react-query": "5.90.4",
    "@tanstack/react-query-devtools": "5.90.2",
    "@vitejs/plugin-react": "^5.1.2",
    "axios": "1.12.2",
    "date-fns": "4.1.0",
    "i18next": "25.6.0",
    "qs": "6.14.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "16.0.1",
    "react-redux": "9.2.0",
    "react-router": "7.12.0",
    "styled-components": "6.1.19",
    "stylis": "4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-angular": "20.0.0",
    "@release-it/conventional-changelog": "10.0.1",
    "@storybook/addon-docs": "9.1.20",
    "@storybook/addon-links": "9.1.20",
    "@storybook/react-vite": "9.1.20",
    "@svgr/cli": "8.1.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.8.0",
    "@types/qs": "6.14.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript-eslint/eslint-plugin": "8.46.1",
    "@typescript-eslint/parser": "8.46.1",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "auto-changelog": "2.5.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cspell": "9.2.1",
    "eslint": "9.37.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.0",
    "eslint-plugin-storybook": "9.1.20",
    "globals": "^16.5.0",
    "husky": "9.1.7",
    "jsdom": "27.0.0",
    "knip": "5.65.0",
    "lint-staged": "16.2.4",
    "prettier": "3.6.2",
    "release-it": "19.0.5",
    "storybook": "9.1.20",
    "typescript": "5.9.3",
    "unplugin-fonts": "1.4.0",
    "vite": "7.1.10",
    "vite-plugin-eslint": "1.8.1",
    "vite-plugin-svgr": "4.5.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  },
  "lint-staged": {
    "*.{js,tsx,ts,css,md}": "prettier --write",
    "*.{js,tsx,ts}": "eslint --cache --fix"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-angular"
    ]
  }
}
